{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ufq-crm-fxh5.onrender.com/api/:path*"
    },
    {
      "source": "/super-admin",
      "destination": "/super-admin/index.html"
    },
    {
      "source": "/super-admin/(.*)",
      "destination": "/super-admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
